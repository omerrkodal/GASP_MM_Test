# This .gitignore is based on Epic's P4IGNORE.
# It is extended for art assets and other code editors such as VS Code
# Use it for Blueprint based projects
# Learn more on how to adjust this file on: https://www.anchorpoint.app/blog/how-to-set-up-a-gitignore-file-for-unreal-engine

#################################
# Unreal Engine generated files #
#################################

# Builds
**/Build/*
**/ArchivedBuilds/*
**/Binaries/*

# Whitelist Binaries folders inside any nested Plugins folder
!**/Plugins/*/Binaries/
!**/Plugins/*/Binaries/**

# Configuration and log files generated by the Editor
**/Saved/*

# Compiled source files for the engine to use
**/Intermediate/*

# Cache files for the editor to use
**/DerivedDataCache/*

# Ignore UBT's configuration.xml
Engine/Programs/UnrealBuildTool/*
*.uatbuildrecord
*.tmp

# Ignore built binaries and temporary build files
*.csprojAssemblyReference.cache
**/obj/*

#######################
# Visual studio files #
########################
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

##################################
# Other code editors and plugins #
##################################
.vscode/
.cursor/
.cursor
.codex/
.codex
.gemini/
.gemini
**/.history
*.xcodeproj
*.xcworkspace

# Ignote sentry
**/sentry.properties
**/.sentry-native

# Ignore JetBrain's IDE folders
.idea/
!.idea/runConfigurations
.gradle/

**/net8.0/*

*.vsconfig
*.props

# Ignore Python cached files
*.pyc

######################
# DCC specific files #
######################
*.blend[1-9]*
*.*@*
*.gi
*.gi2
*_bak*.hip
*_bak*.hipnc

# Ignore files added by Finder on Mac
*.DS_Store

###################
# Project Assets  #
###################
# Local project tools
/ProjectResources/Tools/
/Plugins/VibeUE581860d1833205V1/
/Plugins/GlooPrint/

# Ignore Audio
**/Content/Audio/
**/Audio/

# Ignore MetaHumans
**/Content/MetaHumans/
**/MetaHumans/

# Ignore Characters except MotionMatchingData and ExperimentalStateMachineData
**/Characters/*
!**/Characters/UEFN_Mannequin/
**/Characters/UEFN_Mannequin/*
!**/Characters/UEFN_Mannequin/Animations/
**/Characters/UEFN_Mannequin/Animations/*
!**/Characters/UEFN_Mannequin/Animations/MotionMatchingData/
!**/Characters/UEFN_Mannequin/Animations/MotionMatchingData/**

# Preserve the complete content of the project-local Mover examples plugin.
!/Plugins/MoverExamples/Content/**
!**/Characters/UEFN_Mannequin/Animations/ExperimentalStateMachineData/
!**/Characters/UEFN_Mannequin/Animations/ExperimentalStateMachineData/**
