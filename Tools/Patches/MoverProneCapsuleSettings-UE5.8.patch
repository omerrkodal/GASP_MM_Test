+float UProneCapsuleUtils::GetCollisionHalfHeight(const UCapsuleComponent* Capsule)
+{
+    if (!Capsule) { return 0.f; }
+    if (IsCapsuleHorizontal(Capsule))
+    {
+        if (const UCharacterMoverComponent* Mover = FindCharacterMover(Capsule))
+        {
+            if (const UStanceSettings* Settings = Mover->FindSharedSettings<UStanceSettings>())
+            {
+                return FMath::Max(Capsule->GetUnscaledCapsuleRadius(), Settings->ProneHalfHeight) * Capsule->GetShapeScale();
+            }
+        }
+    }
+    return Capsule->GetScaledCapsuleHalfHeight();
+}
+
+FCollisionShape UProneCapsuleUtils::GetCollisionShape(const UPrimitiveComponent* Primitive, float Inflation)
+{
+    const UCapsuleComponent* Capsule = Cast<UCapsuleComponent>(Primitive);
+    if (!IsCapsuleHorizontal(Capsule)) { return Primitive->GetCollisionShape(Inflation); }
+    const float Radius = FMath::Max(0.f, Capsule->GetScaledCapsuleRadius() + Inflation);
+    return FCollisionShape::MakeCapsule(Radius, FMath::Max(Radius, GetCollisionHalfHeight(Capsule) + Inflation));
+}
+
+float UProneCapsuleUtils::GetPhysicsCapsuleHalfHeight(const UCapsuleComponent* Capsule)
+{
+    float HalfHeight = 0.f;
+    const FBodyInstance* Body = Capsule ? Capsule->GetBodyInstance() : nullptr;
+    if (Body && Body->IsValidBodyInstance())
+    {
+        FPhysicsCommand::ExecuteRead(Body->GetPhysicsActorHandle(), [&](const FPhysicsActorHandle& Actor)
+        {
+            TArray<FPhysicsShapeHandle> Shapes;
+            Body->GetAllShapes_AssumesLocked(Shapes);
+            if (Shapes.Num() == 1 && Shapes[0].GetGeometry().GetType() == Chaos::ImplicitObjectType::Capsule)
+            {
+                const Chaos::FCapsule* Geometry = Shapes[0].GetGeometry().GetObject<Chaos::FCapsule>();
+                HalfHeight = Geometry->GetRadiusf() + 0.5f * FVector(Geometry->GetX2f() - Geometry->GetX1f()).Size();
+            }
+        });
+    }
+    return HalfHeight;
+}
