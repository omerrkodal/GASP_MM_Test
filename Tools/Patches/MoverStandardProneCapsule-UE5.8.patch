-void UProneCapsuleUtils::EnsurePhysicsGeometry(UCapsuleComponent* Capsule)
-{
-    if (!Capsule || !Capsule->IsPhysicsStateCreated()) { return; }
-    FBodyInstance* Body = Capsule->GetBodyInstance();
-    if (!Body || !Body->IsValidBodyInstance() || Body->WeldParent) { return; }
-    const float Radius = Capsule->GetScaledCapsuleRadius();
-    const float HalfLength = FMath::Max((float)FCollisionShape::MinCapsuleAxisHalfHeight(), GetCollisionHalfHeight(Capsule) - Radius);
-    const FVector Axis = IsCapsuleHorizontal(Capsule) ?
-        Capsule->GetComponentQuat().UnrotateVector(GetCapsuleCollisionRotation(Capsule).GetAxisZ()).GetSafeNormal() : FVector::UpVector;
-    const Chaos::FVec3 End = Axis * HalfLength;
-    FPhysicsCommand::ExecuteWrite(Body->GetPhysicsActorHandle(), [&](const FPhysicsActorHandle& Actor)
-    {
-        TArray<FPhysicsShapeHandle> Shapes;
-        Body->GetAllShapes_AssumesLocked(Shapes);
-        // A standard, unwelded capsule has a single shape. Never overwrite compound collision.
-        if (Shapes.Num() != 1) { return; }
-        FPhysicsShapeHandle& Shape = Shapes[0];
-        const Chaos::FImplicitObject& Geometry = Shape.GetGeometry();
-        if (Geometry.GetType() != Chaos::ImplicitObjectType::Capsule) { return; }
-        const Chaos::FCapsule* Existing = Geometry.GetObject<Chaos::FCapsule>();
-        if (FVector(Existing->GetX1f()).Equals(-FVector(End), UE_KINDA_SMALL_NUMBER) &&
-            FVector(Existing->GetX2f()).Equals(FVector(End), UE_KINDA_SMALL_NUMBER) &&
-            FMath::IsNearlyEqual(Existing->GetRadiusf(), Radius)) { return; }
-        // Physics geometry belongs to this actor; no shared CDO/body setup is modified.
-        FPhysicsInterface::SetGeometry(Shape, ::MakeImplicitObjectPtr<Chaos::FCapsule>(-End, End, Radius));
-    });
-}
