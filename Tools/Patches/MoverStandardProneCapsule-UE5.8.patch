-{
-    FVector Difference = FVector::VectorPlaneProject(ImpactPoint - Location, UpDirection);
-    if (IsCapsuleHorizontal(Capsule))
-    {
-        const FVector Axis = GetCapsuleCollisionRotation(Capsule).GetAxisZ();
-        const float HalfLength = FMath::Max(0.f, GetCollisionHalfHeight(Capsule) - Capsule->GetScaledCapsuleRadius());
