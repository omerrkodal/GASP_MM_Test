-bool UProneCapsuleUtils::TryAlignToSurface(UCapsuleComponent* Capsule, const FVector& SurfaceNormal)
-{
-    UCharacterMoverComponent* CharacterMover = FindCharacterMover(Capsule);
-    if (!CharacterMover || !IsCapsuleHorizontal(Capsule)) { return false; }
-    const FVector Normal = SurfaceNormal.GetSafeNormal();
-    if (Normal.IsNearlyZero()) { return false; }
-    if (CharacterMover->ProneCollisionSurfaceNormal.Equals(Normal, UE_KINDA_SMALL_NUMBER)) { return true; }
-    const FQuat CurrentRotation = GetCapsuleCollisionRotation(Capsule);
-    const FQuat DesiredRotation = GetProneRotation(Capsule->GetComponentQuat(), Normal);
-    const FQuat TargetRotation = FQuat::FindBetweenNormals(CurrentRotation.GetAxisZ(), DesiredRotation.GetAxisZ()) * CurrentRotation;
-    const float Angle = CurrentRotation.AngularDistance(TargetRotation);
-    const int32 Steps = FMath::Max(1, FMath::CeilToInt(Angle / FMath::DegreesToRadians(5.f)));
-    FCollisionQueryParams Params(SCENE_QUERY_STAT(ProneSlopeAlignment), false, Capsule->GetOwner());
-    FCollisionResponseParams Response;
-    UMovementUtils::InitCollisionParams(Capsule, Params, Response);
-    // Do not tilt an endpoint through a wall or ceiling. Keep the last accepted
