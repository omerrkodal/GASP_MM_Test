-    {
-        const FQuat TestRotation = FQuat::Slerp(CurrentRotation, TargetRotation, float(Step) / Steps);
-        if (Capsule->GetWorld()->OverlapBlockingTestByChannel(Capsule->GetComponentLocation(), TestRotation,
-            Capsule->GetCollisionObjectType(), GetCollisionShape(Capsule, -0.1f), Params, Response)) { return false; }
-    }
-    CharacterMover->ProneCollisionSurfaceNormal = Normal;
-    EnsurePhysicsGeometry(Capsule);
