+FQuat UProneCapsuleUtils::GetProneRotation(const FQuat& RootRotation, const FVector& SurfaceNormal)
+{
+    const FVector Normal = SurfaceNormal.IsNearlyZero() ? RootRotation.GetAxisZ() : SurfaceNormal.GetSafeNormal();
+    FVector Axis = FVector::VectorPlaneProject(RootRotation.GetAxisX(), Normal).GetSafeNormal();
+    if (Axis.IsNearlyZero())
+    {
+        Axis = FVector::VectorPlaneProject(RootRotation.GetAxisY(), Normal).GetSafeNormal();
+    }
+    if (Axis.IsNearlyZero()) { Axis = RootRotation.GetAxisX(); }
+    // Capsule roll is immaterial; only its local Z (long) axis needs to match.
+    return RootRotation * FQuat::FindBetweenNormals(FVector::UpVector, RootRotation.UnrotateVector(Axis));
+}
+
+FVector UProneCapsuleUtils::GetDesiredSurfaceNormal(const UMoverComponent* MoverComp)
+{
+    if (!MoverComp) { return FVector::UpVector; }
+    const FVector Up = MoverComp->GetUpDirection().GetSafeNormal();
+    const UCharacterMoverComponent* CharacterMover = Cast<UCharacterMoverComponent>(MoverComp);
+    if (CharacterMover && !CharacterMover->IsOnGround()) { return Up; }
+    FFloorCheckResult Floor;
+    const UMoverBlackboard* Blackboard = MoverComp->GetSimBlackboard();
+    if (Blackboard && Blackboard->TryGet(CommonBlackboard::LastFloorResult, Floor))
+    {
+        const FVector Normal = Floor.HitResult.ImpactNormal.GetSafeNormal();
+        if (Floor.IsWalkableFloor() && !Normal.IsNearlyZero() && Normal.Dot(Up) > UE_KINDA_SMALL_NUMBER) { return Normal; }
+        return Up;
+    }
+    // A shape change invalidates the floor cache until Walking recomputes it.
+    // Retain the accepted pose during that gap instead of snapping level.
+    if (CharacterMover && !CharacterMover->ProneCollisionSurfaceNormal.IsNearlyZero())
+    {
+        return CharacterMover->ProneCollisionSurfaceNormal.GetSafeNormal();
+    }
+    return Up;
+}
+
+bool UProneCapsuleUtils::TryAlignToSurface(UCapsuleComponent* Capsule, const FVector& SurfaceNormal)
+{
+    UCharacterMoverComponent* CharacterMover = FindCharacterMover(Capsule);
+    if (!CharacterMover || !IsCapsuleHorizontal(Capsule)) { return false; }
+    const FVector Normal = SurfaceNormal.GetSafeNormal();
+    if (Normal.IsNearlyZero()) { return false; }
+    if (CharacterMover->ProneCollisionSurfaceNormal.Equals(Normal, UE_KINDA_SMALL_NUMBER)) { return true; }
+    const FQuat CurrentRotation = GetCapsuleCollisionRotation(Capsule);
+    const FQuat DesiredRotation = GetProneRotation(Capsule->GetComponentQuat(), Normal);
+    const FQuat TargetRotation = FQuat::FindBetweenNormals(CurrentRotation.GetAxisZ(), DesiredRotation.GetAxisZ()) * CurrentRotation;
+    const float Angle = CurrentRotation.AngularDistance(TargetRotation);
+    const int32 Steps = FMath::Max(1, FMath::CeilToInt(Angle / FMath::DegreesToRadians(5.f)));
+    FCollisionQueryParams Params(SCENE_QUERY_STAT(ProneSlopeAlignment), false, Capsule->GetOwner());
+    FCollisionResponseParams Response;
+    UMovementUtils::InitCollisionParams(Capsule, Params, Response);
+    // Do not tilt an endpoint through a wall or ceiling. Keep the last accepted
+    // normal if any sampled intermediate pose is blocked.
+    for (int32 Step = 1; Step <= Steps; ++Step)
+    {
+        const FQuat TestRotation = FQuat::Slerp(CurrentRotation, TargetRotation, float(Step) / Steps);
+        if (Capsule->GetWorld()->OverlapBlockingTestByChannel(Capsule->GetComponentLocation(), TestRotation,
+            Capsule->GetCollisionObjectType(), Capsule->GetCollisionShape(-0.1f), Params, Response)) { return false; }
+    }
+    CharacterMover->ProneCollisionSurfaceNormal = Normal;
+    EnsurePhysicsGeometry(Capsule);
+    if (Angle > UE_KINDA_SMALL_NUMBER)
+    {
+        if (UMoverBlackboard* Blackboard = CharacterMover->GetSimBlackboard_Mutable())
+        {
+            Blackboard->Invalidate(CommonBlackboard::LastFloorResult);
+        }
+    }
+    Capsule->UpdateOverlaps();
+    return true;
 }
 
