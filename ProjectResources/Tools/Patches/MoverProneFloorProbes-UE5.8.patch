+bool UCharacterMoverComponent::GetProneFloorData(FVector& TipFloorNormal, FVector& BackFloorNormal,
+    bool& TipHasFloor, bool& BackHasFloor, FVector& TipFloorLocation, FVector& BackFloorLocation,
+    FVector& FloorNormal, FVector& FloorLocation) const
+{
+    const FVector Up = GetUpDirection().GetSafeNormal();
+    const FVector Location = GetUpdatedComponentTransform().GetLocation();
+    const bool bCanUseData = IsProne() && IsOnGround();
+    TipHasFloor = bCanUseData && CachedProneFloorData.bTipHasFloor;
+    BackHasFloor = bCanUseData && CachedProneFloorData.bBackHasFloor;
+    TipFloorNormal = TipHasFloor ? CachedProneFloorData.TipFloorNormal : Up;
+    BackFloorNormal = BackHasFloor ? CachedProneFloorData.BackFloorNormal : Up;
+    TipFloorLocation = TipHasFloor ? CachedProneFloorData.TipFloorLocation : Location;
+    BackFloorLocation = BackHasFloor ? CachedProneFloorData.BackFloorLocation : Location;
+    const bool bHasFloor = TipHasFloor || BackHasFloor;
+    FloorNormal = bHasFloor ? CachedProneFloorData.CombinedFloorNormal : Up;
+    FloorLocation = bHasFloor ? CachedProneFloorData.CombinedFloorLocation : Location;
+    return bHasFloor;
+}
