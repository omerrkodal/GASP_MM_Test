+FProneFloorData UProneCapsuleUtils::SampleProneFloorData(const UMoverComponent* MoverComp, const UCapsuleComponent* Capsule)
+{
+    FProneFloorData Data;
+    if (!MoverComp || !Capsule || !IsCapsuleHorizontal(Capsule) || !Capsule->GetWorld()) { return Data; }
+    const UCharacterMoverComponent* CharacterMover = Cast<UCharacterMoverComponent>(MoverComp);
+    if (CharacterMover && !CharacterMover->IsOnGround()) { return Data; }
+
+    const FVector Up = MoverComp->GetUpDirection().GetSafeNormal();
+    const FVector Facing = FVector::VectorPlaneProject(Capsule->GetComponentQuat().GetAxisX(), Up).GetSafeNormal();
+    if (Up.IsNearlyZero() || Facing.IsNearlyZero()) { return Data; }
+    const UCommonLegacyMovementSettings* Settings = MoverComp->FindSharedSettings<UCommonLegacyMovementSettings>();
+    const float FloorReach = Settings ? FMath::Max(0.f, Settings->FloorSweepDistance) : 40.f;
+    const float MaxSlopeCosine = Settings ? Settings->MaxWalkSlopeCosine : 0.71f;
+    const float HalfLength = Capsule->GetScaledCapsuleHalfHeight();
+    const FVector Center = Capsule->GetComponentLocation();
+    FCollisionQueryParams Params(SCENE_QUERY_STAT(ProneFloorProbes), false, Capsule->GetOwner());
+    FCollisionResponseParams Response;
+    UMovementUtils::InitCollisionParams(Capsule, Params, Response);
+
+    auto Sample = [&](float Direction, bool& HasFloor, FVector& Normal, FVector& ImpactPoint)
+    {
+        // Both horizontal offsets and the vertical search bounds are independent
+        // of accepted collision tilt. Changing tilt cannot move these samples along the ground.
+        const FVector Anchor = Center + Facing * (Direction * HalfLength);
+        const FVector Start = Anchor + Up * HalfLength;
+        const FVector End = Anchor - Up * (HalfLength + FloorReach);
+        FHitResult Hit;
+        if (Capsule->GetWorld()->LineTraceSingleByChannel(Hit, Start, End,
+            Capsule->GetCollisionObjectType(), Params, Response) &&
+            UFloorQueryUtils::IsHitSurfaceWalkable(Hit, Up, MaxSlopeCosine))
+        {
+            HasFloor = true;
+            Normal = Hit.ImpactNormal.GetSafeNormal();
+            ImpactPoint = Hit.ImpactPoint;
+        }
+    };
+    Sample(1.f, Data.bTipHasFloor, Data.TipFloorNormal, Data.TipFloorLocation);
+    Sample(-1.f, Data.bBackHasFloor, Data.BackFloorNormal, Data.BackFloorLocation);
+    Data.UpdateCombined();
+    return Data;
+}
